{
  "name": "SnapDown - TikTok, IG & YouTube Downloader",
  "short_name": "SnapDown",
  "description": "Download TikTok, Instagram & YouTube videos without watermark. Installable PWA with share-to-app support.",
  "start_url": "/?utm_source=pwa&utm_medium=install",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "scope": "/",
  "id": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["entertainment", "photo", "utilities"],
  "screenshots": [
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide",
      "label": "SnapDown - No Watermark Downloader"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72.png",
      "sizes": "72x72",
