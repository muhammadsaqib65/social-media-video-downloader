    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Download TikTok",
      "short_name": "TikTok",
      "description": "Paste TikTok link to download without watermark",
      "url": "/?shortcut=tiktok&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Download Instagram",
      "short_name": "Instagram",
      "description": "Download Instagram Reels without watermark",
      "url": "/?shortcut=instagram&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Download YouTube",
      "short_name": "YouTube",
      "description": "Download YouTube videos in HD",
      "url": "/?shortcut=youtube&utm_source=pwa_shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "protocol_handlers": [
    {
      "protocol": "web+snapdown",
      "url": "/?protocol=%s"
    }
  ]
}
